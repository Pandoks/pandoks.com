{
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "plugins": [
    "@pandoks.com/prettier/github-markdown",
    "prettier-plugin-tailwindcss",
    "prettier-plugin-svelte"
  ],
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always"
      }
    },
    {
      "files": ".github/**/*.md",
      "options": {
        "proseWrap": "preserve"
      }
    },
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ]
}
