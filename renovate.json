{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "group:allNonMajor",
    "group:allDigest",
    "customManagers:dockerfileVersions"
  ],
  "labels": ["dependencies"],
  "assignees": ["pandoks"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "dependencyDashboardTitle": "[renovate] 🤖 outdated dependencies (DON'T DELETE)",
  "dependencyDashboardLabels": ["dependencies"],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "postUpdateOptions": ["pnpmDedupe", "gomodTidy"],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+/kube/.+\\.ya?ml$/",
      "/^packages/[^/]+/chart/templates/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)go\\.work$/"],
      "matchStrings": ["(^|\\n)go (?<currentValue>[\\d.]+)\\s*(\\n|$)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "go-mod-directive"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^k3s/.+\\.ya?ml$/",
        "/^infra/vps/cloud-config\\.yaml$/",
        "/^packages/[^/]+/chart/templates/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "repo: (?<registryUrl>https://\\S+)\\s+chart: (?<depName>[a-z0-9][a-z0-9-]*)\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^k3s/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+tag: (?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^apps/.+/kube/.+\\.ya?ml$/"],
      "matchStrings": [
        "chart: oci://\\$\\{ImageRegistry\\}/(?<depName>charts/[a-z0-9-]+)\\s+version: (?<currentValue>\\S+)"
      ],
      "packageNameTemplate": "ghcr.io/pandoks/{{{depName}}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^infra/website\\.ts$/"],
      "matchStrings": ["const NODE_VERSION = '(?<currentValue>[\\d.]+)'"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^infra/runner/ami\\.yaml$/"],
      "matchStrings": ["npm install -g (?<depName>pnpm)@(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/vps/cloud-config\\.yaml$/",
        "/^k3s/overlays/cluster/cluster-upgrade-plan\\.yaml$/",
        "/^scripts/cluster/k3d\\.sh$/"
      ],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^k3s/.+/kustomization\\.ya?ml$/",
        "/^packages/e2e/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Merging a refresh rebuilds Valkey, which changes its digest again.",
      "matchPackageNames": ["ghcr.io/pandoks/valkey"],
      "groupName": "valkey image",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Each cluster add-on chart is its own rollout.",
      "matchDatasources": ["helm"],
      "groupName": null,
      "separateMultipleMinor": true,
      "prBodyNotes": [
        "{{#unless isPatch}}Read the chart's upgrade notes and apply any new CRDs before merging; Helm only installs CRDs on first install.{{/unless}}"
      ]
    },
    {
      "description": "A chart major can carry breaking values, CRD or subchart changes, and one PR can cross several.",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Each argo-cd chart minor carries an Argo CD minor.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["argo-cd"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "Read Argo CD's [upgrade notes](https://argo-cd.readthedocs.io/en/stable/operator-manual/upgrading/overview/) for every minor this crosses."
      ]
    },
    {
      "description": "Our app charts too, and a chart's `version:` can't carry a digest.",
      "matchPackageNames": ["ghcr.io/pandoks/charts/**"],
      "groupName": null,
      "pinDigests": false
    },
    {
      "description": "Main publishes each chart under its Chart.yaml version, so a chart change bumps it and every copy that pins it. Templates compile against the branch's first update, so each chart names its own files.",
      "matchFileNames": ["packages/clickhouse/chart/**"],
      "bumpVersions": [
        {
          "filePatterns": [
            "packages/clickhouse/chart/Chart.yaml",
            "apps/example/kube/clickhouse.yaml"
          ],
          "matchStrings": [
            "\\nversion: (?<version>\\S+)",
            "charts/clickhouse\\s+version: (?<version>\\S+)"
          ]
        }
      ]
    },
    {
      "matchFileNames": ["packages/postgres/chart/**"],
      "bumpVersions": [
        {
          "filePatterns": [
            "packages/postgres/chart/Chart.yaml",
            "apps/example/kube/postgres.yaml",
            "packages/postgres/README.md"
          ],
          "matchStrings": [
            "\\nversion: (?<version>\\S+)",
            "charts/postgres\\s+version: (?<version>\\S+)"
          ]
        }
      ]
    },
    {
      "matchFileNames": ["packages/valkey/chart/**"],
      "bumpVersions": [
        {
          "filePatterns": [
            "packages/valkey/chart/Chart.yaml",
            "apps/example/kube/valkey.yaml",
            "packages/valkey/README.md"
          ],
          "matchStrings": [
            "\\nversion: (?<version>\\S+)",
            "charts/valkey\\s+version: (?<version>\\S+)"
          ]
        }
      ]
    },
    {
      "description": "PgDog's chart uses two-part versions (v0.27).",
      "matchPackageNames": ["pgdog"],
      "versioning": "loose"
    },
    {
      "description": "Every Pulumi CLI copy (mise, the Argo CD plugin image) moves in one PR.",
      "matchPackageNames": ["pulumi/pulumi", "pulumi/pulumi-base"],
      "groupName": "pulumi cli"
    },
    {
      "description": "Kubernetes can't skip minors, so each k3s minor is its own PR.",
      "matchPackageNames": ["k3s-io/k3s"],
      "groupName": "k3s",
      "separateMultipleMinor": true
    },
    {
      "matchPackageNames": ["k3s-io/k3s"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "Check that k3s's [stable channel](https://update.k3s.io/v1-release/channels) has reached this minor, and read its [upgrade notes](https://docs.k3s.io/upgrades/manual). The Plans upgrade servers first, then agents."
      ]
    },
    {
      "description": "Every pnpm copy, the runner AMI's included, moves in one PR. ghcr.io tags have no release timestamp, so they skip minimumReleaseAge; approve once the npm copies are in the PR too.",
      "matchPackageNames": ["pnpm", "ghcr.io/pnpm/pnpm"],
      "groupName": "pnpm",
      "dependencyDashboardApproval": true
    },
    {
      "description": "The Expo SDK pins these, react and react-native exactly; upgrade them together with `pnpm expo install expo@<sdk> --fix`, then remove the `~` Expo writes, match the `react` override in pnpm-workspace.yaml, and run `pnpm install`.",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "jest-expo",
        "test-renderer",
        "react",
        "@types/react",
        "react-native",
        "react-native-*",
        "@react-native/*"
      ],
      "groupName": "expo sdk",
      "dependencyDashboardApproval": true
    },
    {
      "description": "`expo install --check` also holds these to the Expo SDK's versions in the Expo app and its packages.",
      "matchFileNames": ["templates/mobile/package.json", "packages/react-native-*/package.json"],
      "matchPackageNames": ["typescript", "jest", "@types/jest"],
      "groupName": "expo sdk",
      "dependencyDashboardApproval": true
    },
    {
      "description": "React Native's Android build supports JDK 17.",
      "matchDepNames": ["java"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep engines.node a range.",
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
