{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "group:allNonMajor",
    "group:allDigest",
    "customManagers:dockerfileVersions"
  ],
  "labels": ["dependencies"],
  "assignees": ["pandoks"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "dependencyDashboardTitle": "[renovate] 🤖 outdated dependencies (DON'T DELETE)",
  "dependencyDashboardLabels": ["dependencies"],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "postUpdateOptions": ["pnpmDedupe", "gomodTidy"],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+/kube/.+\\.ya?ml$/",
      "/^packages/[^/]+/chart/templates/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)go\\.work$/"],
      "matchStrings": ["(^|\\n)go (?<currentValue>[\\d.]+)\\s*(\\n|$)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "go-mod-directive"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^k3s/.+\\.ya?ml$/",
        "/^infra/vps/cloud-config\\.yaml$/",
        "/^packages/[^/]+/chart/templates/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "repo: (?<registryUrl>https://\\S+)\\s+chart: (?<depName>[a-z0-9][a-z0-9-]*)\\s+version: (?<currentValue>\\S+)",
        "name: &name (?<depName>[a-z0-9-]+)\\n[\\s\\S]*?repo: (?<registryUrl>https://\\S+)\\s+chart: \\*name\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^apps/.+/kube/.+\\.ya?ml$/"],
      "matchStrings": [
        "chart: oci://(?:\\$\\{ImageRegistry\\}|ghcr\\.io/pandoks)/(?<depName>charts/[a-z0-9-]+)\\s+version: (?<currentValue>\\S+)"
      ],
      "packageNameTemplate": "ghcr.io/pandoks/{{{depName}}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^sst\\.config\\.ts$/"],
      "matchStrings": [
        "\\n\\s+(?<depName>cloudflare|github|hcloud|tailscale): '(?<currentValue>[\\d.]+)'",
        "package: '(?<packageName>@ovhcloud/pulumi-ovh)',[\\s\\S]*?version: '(?<currentValue>[\\d.]+)'"
      ],
      "depNameTemplate": "{{#if packageName}}{{{packageName}}}{{else}}@pulumi/{{{depName}}}{{/if}}",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^infra/website\\.ts$/"],
      "matchStrings": ["const NODE_VERSION = '(?<currentValue>[\\d.]+)'"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^infra/runner/ami\\.yaml$/"],
      "matchStrings": ["npm install -g (?<depName>pnpm)@(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/vps/cloud-config\\.yaml$/",
        "/^k3s/overlays/cluster/cluster-upgrade-plan\\.yaml$/",
        "/^scripts/cluster/k3d\\.sh$/"
      ],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^k3s/.+/kustomization\\.ya?ml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Merging a refresh rebuilds Valkey, which changes its digest again.",
      "matchPackageNames": ["ghcr.io/pandoks/valkey"],
      "groupName": "valkey image",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Each cluster add-on chart is its own rollout.",
      "matchDatasources": ["helm"],
      "groupName": null
    },
    {
      "description": "Our app charts too, and a chart's `version:` can't carry a digest.",
      "matchPackageNames": ["ghcr.io/pandoks/charts/**"],
      "groupName": null,
      "pinDigests": false
    },
    {
      "description": "PgDog's chart uses two-part versions (v0.27).",
      "matchPackageNames": ["pgdog"],
      "versioning": "loose"
    },
    {
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["major"],
      "prBodyNotes": [
        "Read the chart's upgrade notes and apply any new CRDs before merging; Helm only installs CRDs on first install."
      ]
    },
    {
      "matchFileNames": ["sst.config.ts"],
      "groupName": "sst providers"
    },
    {
      "description": "Kubernetes can't skip minors, so each k3s minor is its own PR.",
      "matchPackageNames": ["k3s-io/k3s"],
      "groupName": "k3s",
      "separateMultipleMinor": true
    },
    {
      "matchPackageNames": ["k3s-io/k3s"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "Check that k3s's [stable channel](https://update.k3s.io/v1-release/channels) has reached this minor, and read its [upgrade notes](https://docs.k3s.io/upgrades/manual). The Plans upgrade servers first, then agents."
      ]
    },
    {
      "description": "Every pnpm copy, the runner AMI's included, moves in one PR.",
      "matchPackageNames": ["pnpm", "ghcr.io/pnpm/pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Keep the actions pinned in claude-review.yaml out of the all-minor-patch group — claude-code-action skips its review on any PR that changes that file, and it releases almost daily.",
      "matchPackageNames": [
        "anthropics/claude-code-action",
        "actions/checkout",
        "tailscale/github-action"
      ],
      "groupName": "claude-review actions"
    },
    {
      "description": "Keep engines.node a range.",
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
