{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits", "group:allNonMajor", "group:allDigest"],
  "labels": ["dependencies"],
  "assignees": ["pandoks"],
  "minimumReleaseAge": "7 days",
  "dependencyDashboardTitle": "[renovate] 🤖 outdated dependencies (DON'T DELETE)",
  "dependencyDashboardLabels": ["dependencies"],
  "dependencyDashboardAutoclose": false,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "postUpdateOptions": ["pnpmDedupe", "gomodTidy"],
  "kubernetes": {
    "managerFilePatterns": ["/^apps\\/.+\\/kube\\/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Sync the `go` directive in go.work when go.mod is bumped (Renovate's gomod manager only handles go.mod)",
      "managerFilePatterns": ["/(^|/)go\\.work$/"],
      "matchStrings": ["(^|\\n)go (?<currentValue>[\\d.]+)\\s*(\\n|$)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "go-mod-directive"
    },
    {
      "customType": "regex",
      "description": "Track the Go modules compiled into the argocd image: the kustomize release built from source, and the x/text release forced past kustomize's stale pin.",
      "managerFilePatterns": ["/(^|/)packages/argocd/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) packageName=(?<packageName>[^\\s]+)\\s+ARG KUSTOMIZE_VERSION=(?<currentValue>v[\\d.]+)",
        "# renovate: datasource=(?<datasource>[a-z-]+) packageName=(?<packageName>[^\\s]+)\\s+ARG X_TEXT_VERSION=(?<currentValue>v[\\d.]+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track AWS CLI in the argocd image. AWS_CLI_SHA256 must be updated by hand on each bump; a stale checksum fails the image build.",
      "managerFilePatterns": ["/(^|/)packages/argocd/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) packageName=(?<packageName>[^\\s]+)\\s+ARG AWS_CLI_VERSION=(?<currentValue>[\\d.]+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump `version:` pins annotated with a trailing `# renovate: datasource=... packageName=...` comment.",
      "managerFilePatterns": ["/^apps/.+/kube/.+\\.ya?ml$/"],
      "matchStrings": [
        "version:\\s*(?<currentValue>\\S+)\\s*#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+packageName=(?<packageName>[^\\s]+)"
      ],
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Propose reviewable production image digest updates after Build and Publish advances an image's latest tag.",
      "managerFilePatterns": ["/^k3s/images\\.lock\\.json$/"],
      "matchStrings": [
        "\"[^\"]+\":\\s*\"(?<depName>ghcr\\.io/pandoks/[^:\"]+):(?<currentValue>latest)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["helm-values", "helmv3"],
      "groupName": "helm charts"
    },
    {
      "description": "Promote successful package images together in one reviewable GitOps lock update.",
      "matchFileNames": ["k3s/images.lock.json"],
      "groupName": "production images",
      "minimumReleaseAge": "0 days"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  }
}
