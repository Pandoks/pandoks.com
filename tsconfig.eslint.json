{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "eslint.config.ts",
    "*/*/forge.config.ts",
    "*/*/playwright.config.ts",
    "*/*/vitest-setup-client.ts",
    "*/*/vite.main.config.ts",
    "*/*/vite.preload.config.ts",
    "*/*/e2e/*.test.ts",
    "scripts/*/*.ts"
  ]
}
