{
  "name": "pandoks.com",
  "version": "1.0.0",
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.11.0"
  },
  "scripts": {
    "sso": "aws sso login --sso-session=personal --use-device-code --no-browser",
    "tools:install": "mise install --yes",
    "cluster": "./scripts/cluster/main.sh",
    "dev": "sst dev",
    "dev:init": "pnpm cluster k3d deps up && pnpm cluster k3d up && pnpm docker:build && pnpm dev:push && pnpm cluster deploy dev --bootstrap && pnpm cluster deploy dev",
    "dev:destroy": "pnpm cluster k3d down && pnpm cluster k3d deps down",
    "dev:push": "pnpm -r --if-present dev:push",
    "docker:build": "pnpm -r --if-present docker:build",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c packages/svelte",
    "format": "./scripts/format/main.sh",
    "lint": "./scripts/lint/main.sh",
    "fix": "./scripts/fix/main.sh",
    "check:infra": "tsc -p .",
    "check": "pnpm -r --if-present check && pnpm check:infra",
    "postinstall": "sst install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.5",
    "bcryptjs": "3.0.3",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-unicorn": "74.0.0",
    "glob": "13.0.6",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "json-stringify-pretty-compact": "4.0.0",
    "portless": "0.15.6",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "dependencies": {
    "sst": "4.17.1"
  }
}
