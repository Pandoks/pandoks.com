{
  "name": "pandoks.com",
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "sso": "aws sso login --sso-session=personal --use-device-code --no-browser",
    "tools:install": "mise install --yes",
    "cluster": "./scripts/cluster/main.sh",
    "dev": "sst dev",
    "dev:init": "pnpm cluster k3d deps up && pnpm cluster k3d up && pnpm docker:build && pnpm dev:push && pnpm cluster deploy local --bootstrap && pnpm cluster deploy local",
    "dev:destroy": "pnpm cluster k3d down && pnpm cluster k3d deps down",
    "dev:push": "pnpm -r --if-present dev:push",
    "docker:build": "pnpm -r --if-present docker:build",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c packages/svelte",
    "format": "./scripts/format/main.sh",
    "lint": "./scripts/lint/main.sh",
    "fix": "./scripts/fix/main.sh",
    "check:infra": "tsc -p .",
    "check": "pnpm -r --if-present check && pnpm check:infra",
    "postinstall": "[ \"${PANDOKS_INSTALL_MODE:-}\" = dependencies ] || sst install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "bcryptjs": "3.0.3",
    "eslint": "^10.4.0",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "portless": "^0.15.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte-eslint-parser": "^1.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "sst": "^4.17.0"
  }
}
