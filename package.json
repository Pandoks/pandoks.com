{
  "name": "pandoks.com",
  "version": "1.0.0",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "sso": "aws sso login --sso-session=personal --use-device-code --no-browser",
    "tools:install": "mise install --yes",
    "cluster": "./scripts/cluster/main.sh",
    "dev": "sst dev",
    "local:init": "pnpm cluster k3d deps up && pnpm cluster k3d up && pnpm local:build && pnpm local:push && pnpm cluster deploy local --bootstrap --kubeconfig \"$(k3d kubeconfig write local-cluster)\" && pnpm cluster deploy local --kubeconfig \"$(k3d kubeconfig write local-cluster)\"",
    "local:destroy": "pnpm cluster k3d down && pnpm cluster k3d deps down",
    "local:push": "pnpm -r --if-present local:push",
    "local:build": "pnpm -r --if-present local:build",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c packages/svelte",
    "format": "./scripts/format/main.sh",
    "lint": "./scripts/lint/main.sh",
    "test": "./scripts/test/main.sh",
    "check:infra": "tsc -p .",
    "check": "pnpm -r --if-present check && pnpm check:infra",
    "postinstall": "sst install --stage install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@pandoks.com/prettier": "workspace:*",
    "@types/node": "25.9.9",
    "bcryptjs": "3.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "eslint-plugin-unicorn": "76.0.0",
    "glob": "13.0.6",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "json-stringify-pretty-compact": "4.0.0",
    "portless": "0.15.11",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte-eslint-parser": "1.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "sst": "4.17.2"
  }
}
