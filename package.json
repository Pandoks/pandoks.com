{
  "name": "pandoks.com",
  "version": "1.0.0",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "sso": "aws sso login --sso-session=personal --use-device-code --no-browser",
    "tools:install": "mise install --yes",
    "cluster": "./scripts/cluster/main.sh",
    "dev": "sst dev",
    "dev:init": "pnpm cluster k3d deps up && pnpm cluster k3d up && pnpm docker:build && pnpm dev:push && pnpm cluster deploy local --bootstrap && pnpm cluster deploy local",
    "dev:destroy": "pnpm cluster k3d down && pnpm cluster k3d deps down",
    "dev:push": "pnpm -r --if-present dev:push",
    "docker:build": "pnpm -r --if-present docker:build",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c packages/svelte",
    "format": "./scripts/format/main.sh",
    "lint": "./scripts/lint/main.sh",
    "test": "./scripts/test/main.sh",
    "check:infra": "tsc -p .",
    "check": "pnpm -r --if-present check && pnpm check:infra",
    "postinstall": "sst install --stage install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@pandoks.com/prettier": "workspace:*",
    "@types/node": "25.9.9",
    "bcryptjs": "3.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-unicorn": "76.0.0",
    "glob": "13.0.6",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "json-stringify-pretty-compact": "4.0.0",
    "portless": "0.15.7",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "sst": "4.17.1"
  }
}
