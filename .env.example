# NOTE: You need a .env.production, a .env.dev, and a .env.<personal-stage (pandoks)> file
# If you use a .env file, it will override everything and you'll use the same .env for all stages
# HCLOUD_TOKEN is the prod Hetzner project's in .env.production and the dev project's in .env.dev;
# personal stages own no cluster, so .env.<personal-stage> doesn't need it

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=

HCLOUD_TOKEN=

OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

GITHUB_TOKEN=
