user admin on >${ADMIN_PASSWORD} ~* &* +@all
user client on >${CLIENT_PASSWORD} ~* &* +@read +@write +@string +@hash +@list +@set +@sortedset -@dangerous +ping +command +cluster|slots +cluster|shards +cluster|info +asking +client|setname +client|setinfo +eval +evalsha +script|load +time
user default off
