{
  "name": "@pandoks.com/valkey",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "local:build": "pnpm run /^local:build:/",
    "local:build:image": "docker build -f ./Dockerfile ../../ -t localhost:12345/valkey:latest",
    "local:build:reconciler": "docker build -f ./reconciler/Dockerfile ../../ -t localhost:12345/valkey-reconciler:latest",
    "local:build:helm": "rm -f ./valkey-*.tgz && helm package ./chart",
    "local:push": "pnpm run /^local:push:/",
    "local:push:image": "docker push localhost:12345/valkey:latest",
    "local:push:helm": "helm push valkey-*.tgz oci://localhost:12345/charts",
    "local:push:reconciler": "docker push localhost:12345/valkey-reconciler:latest",
    "test": "GOWORK=off go test -C ./reconciler -v ./..."
  }
}
