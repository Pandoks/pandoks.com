# apex-chromium GN build args.
#
# A release build of real Chrome, with the apex fingerprint overlay/edits
# already applied to the tree by scripts/apply.sh. Nothing here enables the
# patches -- they are runtime-gated by the APEX_FP_* environment variables, so
# this binary behaves exactly like stock Chrome when launched without them.

# Release, optimized, official-style build -- a genuine consumer Chrome build,
# so the version string / codecs / behavior match real Chrome. A debug or
# non-official build is itself a fingerprint, so is_official_build stays true.
is_debug = false
is_official_build = true
is_component_build = false

# Real Chrome ships proprietary codecs; a build without them is detectable
# (missing H.264 etc.). Match real Chrome.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Widevine. third_party/widevine/cdm/widevine.gni defaults enable_widevine to
# (is_chrome_branded || is_chrome_for_testing_branded) -- both need
# src-internal, which we don't have -- so a stock Chromium-branded build ships
# WITHOUT the com.widevine.alpha key system. Real Chrome always has it, and its
# absence is one of the "Chromium-Based Browser" tells.
#
# enable_widevine=true alone is NOT enough to make the key system appear: it
# only compiles the CDM component installer, which downloads the CDM into the
# profile dir at runtime -- and the container's egress is proxied, so the
# fetch 403s and the browser reports NotSupportedError for every robustness
# level. The CDM must be IN the image.
#
# bundle_widevine_cdm=true ships the CDM as build output: cdm_registration.cc
# (GetBundledWidevine, compiled when BUNDLE_WIDEVINE_CDM) reads
# <exe dir>/WidevineCdm/{manifest.json,_platform_specific/linux_x64/libwidevinecdm.so}
# at startup and registers com.widevine.alpha from it. scripts/setup.sh drops
# the CDM files into third_party/widevine/cdm/{linux,x64}/ (which is what the
# src-internal checkout would provide; they are fetched from the pinned
# Chrome-for-Testing build), and the bundling target copies them to
# out/apex/WidevineCdm/. sfn-build.sh whitelists that dir into the artifact so
# the runtime image carries it next to the chrome binary.
#
# What this buys: com.widevine.alpha is PRESENT and negotiates SW_SECURE_*
# (L3, software CDM 4.10.3112.0). What it does NOT buy: HW_SECURE_* (L1)
# robustness -- that needs hardware secure-video/TPM, impossible to honestly
# report inside a container. A real desktop with a software-only Widevine
# machine also answers SW-only, so L3 presence is coherent; L1 acceptance is
# the next round's problem.
#
# CDM host verification stays off here (media_options.gni gates it on
# is_chrome_branded && (mac||win)), so no Widevine signing cert is needed
# despite is_official_build.
enable_widevine = true
bundle_widevine_cdm = true

# Desktop platform codecs. proprietary_codecs=true enables the generic codec
# machinery, but the *platform* media gates default OFF on Linux desktop:
# media/media_options.gni defaults enable_platform_ac3_eac3_audio to
# (cast || tvos) and enable_platform_dts_audio to false, so real Windows/macOS
# codecs AC-3/E-AC-3/DTS are missing from canPlayType/MediaSource/EME lists
# (confirmed by the round-2 probe: ac-3/ec-3/mp4a.a5 all false on a persona
# claiming Windows). These are compile-time flags with no runtime GPU-decoder
# dependency on Linux (supported_types.cc returns true directly once enabled),
# so they are safe to force for a desktop persona. They also require
# proprietary_codecs (asserted), which is set above.
enable_platform_ac3_eac3_audio = true
enable_platform_dts_audio = true

# Dolby Vision demuxing (dvh1/dvhe). Default (cast || is_win) -- off on Linux.
# Requires enable_platform_hevc, which enable_hevc_parser_and_hw_decoder
# already turns on for is_linux + proprietary_codecs. Runtime decode support
# still consults the GPU-process supplemental decoder cache (empty on a
# GPU-less container); the persona override for that lives in
# supported_types.cc (apex-media-hevc / apex-media-dv) and is env-gated, so
# this flag just makes the parser/flag machinery reachable.
enable_platform_dolby_vision = true

# Field trials. components/variations/service/BUILD.gn defaults
# disable_fieldtrial_testing_config to false, so a Chromium-branded build
# compiles testing/variations/fieldtrial_testing_config.json in AND applies
# it at startup: ShouldUseFieldTrialTestingConfig() in
# variations_field_trial_creator.cc applies it on every non-Chrome-branded
# build unless --disable-field-trial-config is passed (and the launchers
# deliberately pass no such flag -- it is itself a Playwright tell). Real
# Chrome never applies it: branded builds gate it behind
# --enable-field-trial-config and stable users get their trials from the
# variations seed instead. So every session of this binary carried the same
# set of testing-config experiment arms -- feature state the stable
# population mostly lacks, identical across the whole fleet. Setting this
# flips FIELDTRIAL_TESTING_ENABLED to false, which compiles the config out
# entirely (no runtime flag to forget, nothing on the command line). The
# binary then runs plain feature defaults: an unbranded build never fetches a
# seed either (variations_service.cc skips the fetch without
# --variations-server-url), which is the state of a real Chrome before its
# first seed fetch -- a real population, unlike the testing config's.
disable_fieldtrial_testing_config = true

# No symbols -- apex never needs to debug the binary, real Chrome release ships
# stripped, and symbol_level=0 meaningfully cuts compile time + disk.
symbol_level = 0
blink_symbol_level = 0

# Do NOT enable dcheck in release (real Chrome release has it off).
dcheck_always_on = false

# (NaCl is already fully removed from current Chromium -- no arg needed.)

# PGO (profile-guided optimization) is a pure codegen speed optimization -- it
# is NOT web-observable and cannot be fingerprinted. The --no-history fetch
# skips the PGO profile data, so we disable PGO rather than download it. The
# resulting binary's behavior / version / feature set is identical.
chrome_pgo_phase = 0

# Build the local toolchain; no remote execution available here.
use_remoteexec = false

# Skip building unbundled test binaries / the chromedriver target -- apex
# only needs the `chrome` target. (autoninja is told `chrome` explicitly,
# but this trims dependency graph work.)
blink_enable_generated_code_formatting = false

# Disable siso, use plain ninja. siso is Google's distributed-build runner
# for their RBE cluster; we have no RBE access so siso's local-fallback mode
# just blocks ccache from intercepting compile calls. Plain ninja + ccache
# is the well-trodden path for non-Google Chromium builds.
use_siso = false

# Route every C/C++ compile call through ccache. GN-native equivalent to
# CC="ccache clang" — cleaner because GN owns command construction.
# Requires ccache in PATH (installed via ami.yaml:21).
cc_wrapper = "ccache"

# Disable Clang header modules (-fmodules). This is the SINGLE most
# important arg for making ccache actually work. Without this, every
# C++ compile gets -fmodules in cflags, and BOTH ccache and sccache
# (verified against mozilla/sccache's README) refuse to cache compiles
# with -fmodules — they treat them as uncacheable because .pcm files
# reference binary state the cache can't hash.
#
# Empirical proof: build 142930 with -fmodules on, CCACHE_SLOPPINESS=modules
# set: still 88.39% uncacheable. The sloppiness only relaxes hashing for
# C++20 NAMED modules (-fmodule-file=), not Clang header modules (-fmodules).
# Chromium uses BOTH.
#
# Source: chromium build/config/compiler/BUILD.gn — the -fmodules block is
# only emitted when use_clang_modules is true. Disabling it drops the flag
# AND the USE_LIBCXX_MODULES define, which together make the entire compile
# graph cache-friendly.
#
# Trade-off: slightly slower cold compile (modules speed up header parsing
# during a fresh build), but warm builds become genuinely cached — ~10min
# vs ~60min. For a project where we iterate on patches, this is a massive
# win. The emitted binary is identical at the assembly level either way
# (modules are a compile-time concept, not a runtime one).
use_clang_modules = false
