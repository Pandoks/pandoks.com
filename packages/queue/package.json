{
  "name": "@pandoks.com/queue",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "check": "tsc --noEmit",
    "test": "pnpm run test:go && pnpm run test:python && pnpm run test:ts",
    "test:go": "GOWORK=off go test -race ./...",
    "test:python": "uv run --project ./python --frozen python -m unittest discover -s ./python/tests",
    "test:ts": "vitest run"
  },
  "exports": {
    ".": "./src/queue.ts"
  },
  "peerDependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
