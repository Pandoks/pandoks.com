{
  "name": "@pandoks.com/clickhouse",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "local:build": "pnpm run /^local:build:/",
    "local:build:clickhouse": "docker build -f ./clickhouse/Dockerfile ../../ -t localhost:12345/clickhouse:latest",
    "local:build:keeper": "docker build -f ./keeper/Dockerfile ../../ -t localhost:12345/clickhouse-keeper:latest",
    "local:build:backup": "docker build -f ./backup/Dockerfile ../../ -t localhost:12345/clickhouse-backup:latest",
    "local:build:helm": "rm -f ./clickhouse-*.tgz && helm package ./chart",
    "local:push": "pnpm run /^local:push:/",
    "local:push:clickhouse": "docker push localhost:12345/clickhouse:latest",
    "local:push:keeper": "docker push localhost:12345/clickhouse-keeper:latest",
    "local:push:backup": "docker push localhost:12345/clickhouse-backup:latest",
    "local:push:helm": "helm push clickhouse-*.tgz oci://localhost:12345/charts"
  }
}
