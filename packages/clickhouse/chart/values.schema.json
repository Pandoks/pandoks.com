{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["storage"],
  "properties": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "object"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["local", "object", "mixed"]
        },
        "object": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "region",
            "bucket",
            "credentialsSecret",
            "cacheSize"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string"
            },
            "credentialsSecret": {
              "type": "string"
            },
            "cacheSize": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*(Ki|Mi|Gi|Ti))$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "mode": {
                "enum": ["object", "mixed"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "storage": {
            "properties": {
              "object": {
                "properties": {
                  "endpoint": {
                    "pattern": "^https?://.+"
                  },
                  "bucket": {
                    "minLength": 1
                  },
                  "credentialsSecret": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
