{
  "name": "@pandoks.com/desktop-template",
  "productName": "Pandoks Desktop Template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "portless run --name desktop-template vite dev",
    "build": "vite build",
    "preview": "portless run --name desktop-template-preview vite preview",
    "package": "vite build && electron-forge package",
    "make": "vite build && electron-forge make",
    "publish": "electron-forge publish",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run /^test:/",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c ../../packages/svelte"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "electron": "42.9.3",
    "jsdom": "30.0.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@pandoks.com/svelte": "workspace:*",
    "electron-squirrel-startup": "1.0.1"
  }
}
