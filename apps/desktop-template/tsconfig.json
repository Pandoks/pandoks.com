{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "sourceMap": true,
    "strict": true
  },
  "include": [
    "vite.config.js",
    "vite.config.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "test/**/*.js",
    "test/**/*.ts",
    "test/**/*.svelte",
    "tests/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.svelte",
    "electron/**/*.ts",
    "forge.env.d.ts"
  ]
}
