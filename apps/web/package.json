{
  "name": "@pandoks.com/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "portless run --name web vite dev",
    "build": "vite build",
    "preview": "portless run --name web-preview vite preview",
    "sync:notion": "node ./scripts/notion.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c ../../packages/svelte"
  },
  "dependencies": {
    "@pandoks.com/svelte": "workspace:*",
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@notionhq/client": "5.31.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/enhanced-img": "1.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/subset-font": "2.3.0",
    "jsdom": "31.0.0",
    "node-html-parser": "9.0.6",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
