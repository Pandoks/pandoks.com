{
  "name": "@pandoks.com/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "portless run --name web vite dev",
    "build": "vite build",
    "preview": "portless run --name web-preview vite preview",
    "sync:notion": "node ./scripts/notion.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run /^test:/",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c ../../packages/svelte"
  },
  "dependencies": {
    "@pandoks.com/svelte": "workspace:*",
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@notionhq/client": "5.26.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/subset-font": "2.3.0",
    "jsdom": "30.0.1",
    "node-html-parser": "7.1.0",
    "serve": "14.2.6",
    "sharp": "0.35.4",
    "subset-font": "2.5.0",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.11"
  }
}
